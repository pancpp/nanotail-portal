# GraphQL schema example
#
# https://gqlgen.com/getting-started/

scalar Int64
scalar Uint64
scalar Time
"A JSON object with dynamic keys, such as Tailscale capability names."
scalar Map

type User {
  id: Int64!
  username: String!
  role: String!
  createTime: Time!
  updateTime: Time!
}

type TailscaleUser {
  id: Int64!
  loginName: String!
  displayName: String!
  profilePicURL: String!
}

type Tailnet {
  name: String!
  magicDNSSuffix: String!
  magicDNSEnabled: Boolean!
}

type TailscaleDNSRecord {
  name: String!
  # An empty type means A or AAAA, inferred from the value.
  type: String!
  value: String!
}

type TailscaleClientVersion {
  runningLatest: Boolean!
  # Empty when the client is already running the latest version.
  latestVersion: String!
  urgentSecurityUpdate: Boolean!
  notify: Boolean!
  notifyURL: String!
  notifyText: String!
}

type TailscalePeer {
  id: String!
  nodeID: Int64!
  publicKey: String!
  hostName: String!
  dnsName: String!
  os: String!
  userID: Int64!
  tailscaleIPs: [String!]!
  allowedIPs: [String!]!
  tags: [String!]!
  addrs: [String!]
  curAddr: String!
  relay: String!
  peerRelay: String!
  rxBytes: Int64!
  txBytes: Int64!
  created: Time!
  # Tailscale's zero timestamps represent an unknown time; gqlgen emits null.
  lastWrite: Time
  lastSeen: Time
  lastHandshake: Time
  online: Boolean!
  exitNode: Boolean!
  exitNodeOption: Boolean!
  active: Boolean!
  peerAPIURL: [String!]!
  taildropTarget: Int!
  noFileSharingReason: String!
  # Capability values can be null or arbitrary JSON, not just booleans.
  capMap: Map
  inNetworkMap: Boolean!
  inMagicSock: Boolean!
  inEngine: Boolean!
  keyExpiry: Time
}

type TailscaleStatus {
  version: String!
  tun: Boolean!
  backendState: String!
  haveNodeKey: Boolean!
  authURL: String!
  tailscaleIPs: [String!]!
  health: [String!]!
  magicDnsSuffix: String!
  currentTailnet: Tailnet
  certDomains: [String!]
  extraRecords: [TailscaleDNSRecord!]
  clientVersion: TailscaleClientVersion
  self: TailscalePeer
  peers: [TailscalePeer!]!
}

type TailscaleClient {
  id: Int64!
  clientId: String!
  hasClientSecret: Boolean!
  createTime: Time!
  updateTime: Time!
}

type DeviceStatus {
  "Hostname of the device"
  hostname: String!
  "Active NetworkManager IPv4 profile method: static, DHCP, link-local, shared, disabled, or unknown."
  lanIPType: String!
  "One eth0 IPv4 address with CIDR prefix; prefers non-link-local, then lexical order. Empty if absent."
  lanIP: String!
  "NetworkManager's active eth0 IPv4 gateway; empty if absent."
  gateway: String!
  "IPv4 and IPv6 DNS servers reported by NetworkManager for eth0, not the system resolver stub."
  dns: [String!]!
  "Active NetworkManager IPv6 profile method; auto means SLAAC and/or DHCPv6, unknown if no active profile."
  lanIPv6Type: String!
  "One eth0 IPv6 address with CIDR prefix; prefers non-link-local, then lexical order. Empty if absent."
  lanIPv6: String!
  "NetworkManager's active eth0 IPv6 gateway; empty if absent."
  gateway6: String!
  "MAC address of eth0."
  ethAddr: String!
  "CPU utilization across all cores over 200 ms, rounded to 0–100 percent."
  cpuload: Int!
  "RAM usage based on MemTotal minus MemAvailable, rounded to 0–100 percent."
  memory: Int!
  "System boot time, not the portal process start time."
  lastRestart: Time!
  "System uptime in whole seconds."
  uptime: Int64!
  "Currently always healthy; system-health checks are not implemented yet."
  health: String!
}

type Query {
  user: User!
  tailscaleClient: TailscaleClient
  tailscaleStatus: TailscaleStatus!
  deviceStatus: DeviceStatus!
}

input ChangePassword {
  oldpassword: String!
  newpassword: String!
}

input TailscaleCredential {
  clientId: String!
  "Omit to retain the saved secret when the client ID is unchanged."
  clientSecret: String
}

input DeviceIP {
  "Static or DHCP."
  type: String!
  "IPv4 with CIDR prefix to set or empty for DHCP."
  ip: String!
  "Optional gateway IPv4 in the same subnet. Empty clears it; must be empty for DHCP."
  gateway: String!
  "Up to eight IPv4 DNS servers. Empty clears them; must be empty for DHCP."
  dns: [String!]!
}

type Mutation {
  changePassword(passwords: ChangePassword!): Boolean!
  setTailscaleCredential(credential: TailscaleCredential!): Boolean!
  clearTailscaleCredential: Boolean!
  "Admin only: persist and apply eth0 IPv4 settings through NetworkManager. IPv6 is unchanged; the connection may be interrupted."
  setDeviceIP(deviceIP: DeviceIP): Boolean!
}
