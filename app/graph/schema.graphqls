# GraphQL schema example
#
# https://gqlgen.com/getting-started/

scalar Int64
scalar Uint64
scalar Time
"A JSON object with dynamic keys, such as Tailscale capability names."
scalar Map

type User {
  id: Int64!
  username: String!
  role: String!
  createTime: Time!
  updateTime: Time!
}

type TailscaleUser {
  id: Int64!
  loginName: String!
  displayName: String!
  profilePicURL: String!
}

type Tailnet {
  name: String!
  magicDNSSuffix: String!
  magicDNSEnabled: Boolean!
}

type TailscaleDNSRecord {
  name: String!
  # An empty type means A or AAAA, inferred from the value.
  type: String!
  value: String!
}

type TailscaleClientVersion {
  runningLatest: Boolean!
  # Empty when the client is already running the latest version.
  latestVersion: String!
  urgentSecurityUpdate: Boolean!
  notify: Boolean!
  notifyURL: String!
  notifyText: String!
}

type TailscalePeer {
  id: String!
  nodeID: Int64!
  publicKey: String!
  hostName: String!
  dnsName: String!
  os: String!
  userID: Int64!
  tailscaleIPs: [String!]!
  allowedIPs: [String!]!
  tags: [String!]!
  addrs: [String!]
  curAddr: String!
  relay: String!
  peerRelay: String!
  rxBytes: Int64!
  txBytes: Int64!
  created: Time!
  # Tailscale's zero timestamps represent an unknown time; gqlgen emits null.
  lastWrite: Time
  lastSeen: Time
  lastHandshake: Time
  online: Boolean!
  exitNode: Boolean!
  exitNodeOption: Boolean!
  active: Boolean!
  peerAPIURL: [String!]!
  taildropTarget: Int!
  noFileSharingReason: String!
  # Capability values can be null or arbitrary JSON, not just booleans.
  capMap: Map
  inNetworkMap: Boolean!
  inMagicSock: Boolean!
  inEngine: Boolean!
  keyExpiry: Time
}

type TailscaleStatus {
  version: String!
  tun: Boolean!
  backendState: String!
  haveNodeKey: Boolean!
  authURL: String!
  tailscaleIPs: [String!]!
  health: [String!]!
  magicDnsSuffix: String!
  currentTailnet: Tailnet
  certDomains: [String!]
  extraRecords: [TailscaleDNSRecord!]
  clientVersion: TailscaleClientVersion
  self: TailscalePeer
  peers: [TailscalePeer!]!
}

type TailscaleClient {
  id: Int64!
  clientId: String!
  hasClientSecret: Boolean!
  createTime: Time!
  updateTime: Time!
}

type Query {
  user: User!
  tailscaleClient: TailscaleClient
  tailscaleStatus: TailscaleStatus!
}

input ChangePassword {
  oldpassword: String!
  newpassword: String!
}

input TailscaleCredential {
  clientId: String!
  "Omit to retain the saved secret when the client ID is unchanged."
  clientSecret: String
}

type Mutation {
  changePassword(passwords: ChangePassword!): Boolean!
  setTailscaleCredential(credential: TailscaleCredential!): Boolean!
  clearTailscaleCredential: Boolean!
}
